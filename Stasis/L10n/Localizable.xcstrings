      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Connect the adapter to begin the final charge." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "连接电源适配器，开始最后一次充电。" } },
