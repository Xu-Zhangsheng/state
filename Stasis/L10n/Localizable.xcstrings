    "A guided full-charge and discharge cycle helps the macOS fuel gauge refresh its reading." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "A guided full-charge and discharge cycle helps the macOS fuel gauge refresh its reading." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "通过引导完成一次完整充放电循环，帮助 macOS 电池计量器刷新读数。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "透過引導完成一次完整充放電循環，幫助 macOS 電池計量器重新整理讀數。" } }
      }
    },
    "Battery Calibration" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Battery Calibration" } },
