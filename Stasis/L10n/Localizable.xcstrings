    "Connect the power adapter before starting." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Connect the power adapter before starting." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "开始前请连接电源适配器。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "開始前請連接電源轉接器。" } }
