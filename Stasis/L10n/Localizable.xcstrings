    "Power values are displayed with one decimal place. The app list is supplied by the energy metrics service." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Power values are displayed with one decimal place. The app list is supplied by the energy metrics service."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "功率精确显示到小数点后一位；App 列表由能耗指标服务提供。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "功率精確顯示到小數點後一位；App 列表由能耗指標服務提供。"
          }
        }
      }
    },
    "Prevent your Mac from sleeping while charging towards the charge limit. Sleep is re-enabled once the limit is reached or the adapter is disconnected." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prevent your Mac from sleeping while charging towards the charge limit. Sleep is re-enabled once the limit is reached or the adapter is disconnected."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngăn máy Mac chuyển sang chế độ ngủ khi đang sạc đến mức giới hạn. Chế độ ngủ sẽ tự động kích hoạt lại khi đạt mức giới hạn hoặc khi ngắt kết nối bộ sạc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在向充电上限充电期间阻止 Mac 进入睡眠。达到上限或断开充电器后，睡眠会重新启用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在向充電上限充電期間阻止 Mac 進入睡眠。達到上限或斷開電源轉接器後，睡眠會重新啓用。"
          }
        }
      }
    },
