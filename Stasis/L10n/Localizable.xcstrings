    },
    "Charging control is unavailable. Install and authorize the state helper first." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Charging control is unavailable. Install and authorize the state helper first." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "充电控制不可用。请先安装并授权 state 助手。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "充電控制無法使用。請先安裝並授權 state 助手。" } }
      }
    },
    "Cancel Calibration" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Cancel Calibration" } },
